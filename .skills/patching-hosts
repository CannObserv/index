# co-index's patching knob (#9). Grammar: skills/patching-hosts/references/knob.md.
# Times are UTC.

class dev                          # D9: off every production path
posture scheduled

# Clients are near-silent 05:00-12:00 UTC (Qdrant's access log, 2026-10-01..08).
window Tue 05:15-11:45
window Wed 05:15-11:45
window Thu 05:15-11:45

# qdrant-cert-renew.timer: Mon 04:00 plus up to 1h RandomizedDelaySec; it
# restarts Qdrant when the certificate changed.
quiet 04:00-05:05 Mon

service qdrant.service
service ollama.service
restarter qdrant-cert-renew.timer

# The Ollama image is this repo's to update, never a patching run's (#11): a
# new engine can change every vector, so it's an engine change (deploy/README.md).
# The probe matches owner globs against binaries only, not container images,
# so this line is the grammar's intent and the probe reads it as nothing yet
# (upstream, #11).
owner socraticode/ollama-slim self

# Unauthenticated endpoints, on the name and port clients use (D3, D14).
health curl -sf --max-time 5 https://index.taild0fb76.ts.net:6333/readyz
health curl -sf --max-time 5 http://index.taild0fb76.ts.net:11434/api/tags

# Qdrant writes in the last 5 min; a client's index run shows nowhere else (D11).
inflight /usr/local/bin/index-inflight.sh

# Scoped by deploy/apt-preferences.d/tailscale. tailscaled's restart is its own
# step: Qdrant and Ollama bind the tailnet address (D3).
origin pkgs.tailscale.com follow
hold tailscale tailscale

# No datastore line: the grammar has none for Qdrant (to be filed upstream,
# #9 step 4). Before any step that stops Qdrant, `sudo qdrant-recovery.sh
# snapshot`, copied off the node; after it, `qdrant-recovery.sh check`.
# exe-setup.service re-runs the platform's setup script every boot; its
# Tailscale auth key is revoked (owner, 2026-10-08), so a re-run joins nothing.
exception setup-script:redelivered 2027-01-08 the script's Tailscale auth key is revoked

# No caller lines: an outage degrades codebase_search to grep (D9).
