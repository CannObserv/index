[Unit]
Description=Ollama embedding server for the cohort's SocratiCode index
Documentation=https://github.com/CannObserv/notifier/issues/57

# tailscaled is ORDERING ONLY, for the reason qdrant.service gives at length.
After=network.target tailscaled.service docker.service
Requires=docker.service

# [Unit], not [Service]: qdrant.service says why.
StartLimitBurst=5
StartLimitIntervalSec=600

[Service]
Type=exec
ExecStart=/usr/local/bin/ollama-run.sh
ExecStop=/usr/bin/docker stop --timeout 30 ollama
# always, not on-failure: Ollama exits 0 on SIGTERM, so under on-failure an
# out-of-band `docker stop ollama` ended the unit for good (#5). An explicit
# stop never restarts under either; the start limit in [Unit] bounds a loop.
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
